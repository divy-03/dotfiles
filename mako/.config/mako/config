# Position
anchor=top-right

# Timeout in milliseconds
default-timeout=5000

# Style
border-size=2
border-radius=8
padding=12
font=JetBrainsMono Nerd Font 12

# Max visible notifications
max-visible=5

# colors generated from the wallpaper by matugen (see ~/.config/matugen)
include=~/.config/mako/colors
