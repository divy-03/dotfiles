#!/usr/bin/env python3
"""Backlight of a Kreo Swarm 75 on its 2.4G receiver, without Kreo Kontrol.

Speaks Kontrol's wireless "bytech" protocol over /dev/hidraw; the udev rule
from Kontrol's Linux installer (/etc/udev/rules.d/70-kreo.rules) already gives
the logged-in user access. Byte layouts match what Kontrol's own driver writes.

Only the lighting of the preset effects is written: which effect runs, and its
brightness, speed and color. The rest of those blocks (debounce, sleep timer,
NKRO, ...) goes back exactly as read, and keymaps, macros and per-key colors
are never written. The first write saves the original state to restore.

usage:
  kreo status                          effect, color, brightness, speed, battery
  kreo set <#rrggbb|@file> [--effect E] [--brightness 0-4] [--speed 0-4] [--dry-run]
                                       one color for the current effect (left
                                       alone if it takes none), or for effect E,
                                       a name from `kreo effects` or its id;
                                       @file is read once the keyboard is free,
                                       so of several queued runs the newest wins
  kreo effects                         effects that take a color
  kreo backup [dir]                    save the lighting state (read only)
  kreo restore [dir]                   put a backup's lighting back
                                       (default: the one taken before the first write)
"""

import fcntl
import os
import select
import sys
import time

REPORT = 0x13
VID_PID = "00003554:0000FA09"
VENDOR_USAGE = bytes([0x06, 0x02, 0xFF, 0x09, 0x02])  # usage page 0xFF02, usage 2

GET_ONLINE, GET_POWER = 0x07, 0x4A
GET_PROFILE, SET_PROFILE = 0x44, 0x04
GET_COLORS, SET_COLORS = 0x49, 0x09
GET_CUSTOM = 0x42  # per-key colors, only ever read (for backups)
READS = {GET_ONLINE, GET_POWER, GET_PROFILE, GET_COLORS, GET_CUSTOM}
WRITES = {SET_PROFILE, SET_COLORS}

PROFILE_LEN, COLORS_LEN, COLORS_WRITE_LEN = 128, 490, 512
TRAILER = b"\x5a\xa5"
EFFECT_TABLE = 56  # "ff ff", then (brightness, speed << 4 | color mode) per effect
BRIGHTNESS_MAX = SPEED_MAX = 4

# id -> name, for the effects that take one color (Kontrol's list)
EFFECTS = {
    1: "static", 2: "breathing", 4: "flash-away", 5: "raindrops", 6: "rainbow-wheel",
    7: "ripples", 8: "stars", 9: "shadow", 10: "snake", 11: "neon-stream",
    12: "reaction", 13: "sine-wave", 14: "scanning", 18: "storm",
}
OTHER_EFFECTS = {0: "off", 3: "rainbow", 15: "windmill", 16: "waterfall",
                 17: "blossoming", 277: "per-key"}

# every byte `set` may change: the effect id, and each color effect's
# brightness/speed pair and its color (first of 7 colors per effect)
SET_PROFILE_BYTES = {9, 10} | {EFFECT_TABLE + 2 * e + k for e in EFFECTS for k in (0, 1)}
SET_COLOR_BYTES = {21 * e + k for e in EFFECTS for k in range(3)}

DATA = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "kreo")
ORIGINAL = os.path.join(DATA, "original")


class KreoError(Exception):
    pass


def checksum(body):
    return (REPORT + sum(body)) & 0xFF


def packets(cmd, payload):
    """A write split into 19-byte packets: cmd, count, index, length, 14 bytes, checksum."""
    count = -(-len(payload) // 14)
    out = []
    for i in range(count):
        chunk = payload[i * 14:(i + 1) * 14]
        body = bytes([cmd, count, i, len(chunk)]) + chunk.ljust(14, b"\0")
        out.append(body + bytes([checksum(body)]))
    return out


def find_hidraw():
    for dev in sorted(os.listdir("/sys/class/hidraw")):
        base = f"/sys/class/hidraw/{dev}/device"
        try:
            with open(f"{base}/uevent") as f:
                if VID_PID not in f.read().upper():
                    continue
            with open(f"{base}/report_descriptor", "rb") as f:
                if VENDOR_USAGE in f.read():
                    return f"/dev/{dev}"
        except OSError:
            continue
    raise KreoError("Kreo receiver not found (is the 2.4G dongle plugged in?)")


class Receiver:
    def __init__(self, path=None):
        self.fd = os.open(path or find_hidraw(), os.O_RDWR | os.O_NONBLOCK)

    def close(self):
        os.close(self.fd)

    def send(self, packet):
        os.write(self.fd, bytes([REPORT]) + packet)

    def recv(self, cmd, deadline):
        """The next packet answering cmd (keypresses and battery pushes are skipped)."""
        while (left := deadline - time.monotonic()) > 0:
            if not select.select([self.fd], [], [], left)[0]:
                break
            data = os.read(self.fd, 64)
            if len(data) < 20 or data[0] != REPORT or data[1] != cmd:
                continue
            p = data[1:20]
            if checksum(p[:18]) != p[18]:
                raise KreoError(f"bad checksum from keyboard: {p.hex(' ')}")
            if p[1] & 0x80:
                raise KreoError(f"keyboard reported an error for command 0x{cmd:02x}")
            return p
        return None

    def drain(self):
        while select.select([self.fd], [], [], 0)[0]:
            os.read(self.fd, 64)

    def get(self, cmd, timeout=1.5):
        if cmd not in READS:
            raise KreoError(f"refusing to send 0x{cmd:02x}: not a read")
        self.drain()
        body = bytes([cmd, 1, 0, 0]) + bytes(14)
        self.send(body + bytes([checksum(body)]))
        chunks, deadline = {}, time.monotonic() + timeout
        while (p := self.recv(cmd, deadline)) is not None:
            chunks[p[2]] = p[4:4 + (p[3] & 0x0F)]
            if len(chunks) == p[1] & 0x7F:
                return b"".join(chunks[i] for i in range(len(chunks)))
        raise KreoError(f"no answer to 0x{cmd:02x}: is the keyboard on and awake?")

    def put(self, cmd, payload):
        if cmd not in WRITES:
            raise KreoError(f"refusing to send 0x{cmd:02x}: only lighting is written")
        self.drain()
        time.sleep(0.06)
        for i, packet in enumerate(packets(cmd, payload)):
            self.send(packet)
            ack = self.recv(cmd, time.monotonic() + 1.0)
            if ack is None or ack[2] != i:
                raise KreoError(f"keyboard did not acknowledge packet {i} of 0x{cmd:02x}; "
                                "nothing past it was sent, run `kreo restore` if lighting looks off")
            time.sleep(0.05)
        time.sleep(0.1)


def read_state(rx):
    if rx.get(GET_ONLINE) != b"\x01":
        raise KreoError("the receiver says the keyboard is offline")
    profile, colors = rx.get(GET_PROFILE), rx.get(GET_COLORS)
    check(profile, colors)
    return profile, colors


def check(profile, colors):
    if len(profile) != PROFILE_LEN or profile[-2:] != TRAILER:
        raise KreoError("unexpected settings block from the keyboard; not touching it")
    if profile[EFFECT_TABLE:EFFECT_TABLE + 2] != b"\xff\xff":
        raise KreoError("effect table not where expected; not touching it")
    if len(colors) != COLORS_LEN:
        raise KreoError("unexpected color table from the keyboard; not touching it")


def effect_of(profile):
    return profile[9] << 8 | profile[10]


def describe(profile, colors):
    effect = effect_of(profile)
    name = EFFECTS.get(effect) or OTHER_EFFECTS.get(effect, f"effect {effect}")
    if effect not in EFFECTS:
        return name
    level, speed = profile[EFFECT_TABLE + 2 * effect], profile[EFFECT_TABLE + 2 * effect + 1]
    color = colors[21 * effect:21 * effect + 3]
    mode = f"#{color.hex()}" if speed & 0x0F == 0 else "colorful"
    return f"{name} {mode} brightness {level}/{BRIGHTNESS_MAX} speed {speed >> 4}/{SPEED_MAX}"


def colors_write(colors):
    """The color table as Kontrol writes it back: padded to 512, trailer at 506."""
    out = bytearray(COLORS_WRITE_LEN)
    out[:COLORS_LEN] = colors
    out[506:508] = TRAILER
    return bytes(out)


def changed(old, new):
    return {i for i in range(len(new)) if i >= len(old) or old[i] != new[i]}


def build(profile, colors, rgb, effect, brightness=None, speed=None):
    """New settings and color blocks; only the chosen effect's lighting bytes differ."""
    p, c = bytearray(profile), bytearray(colors)
    lvl, spd = EFFECT_TABLE + 2 * effect, EFFECT_TABLE + 2 * effect + 1
    p[9], p[10] = effect >> 8, effect & 0xFF
    if brightness is not None:
        p[lvl] = brightness
    p[spd] = (p[spd] >> 4 if speed is None else speed) << 4  # low nibble 0: one color
    c[21 * effect:21 * effect + 3] = bytes(rgb)
    # guard: nothing but these bytes may ever change
    if not changed(profile, p) <= {9, 10, lvl, spd}:
        raise KreoError("internal check failed: settings bytes outside lighting would change")
    if not changed(colors, c) <= {21 * effect, 21 * effect + 1, 21 * effect + 2}:
        raise KreoError("internal check failed: colors outside the effect would change")
    return bytes(p), bytes(c)


def write(rx, old, new):
    (profile, colors), (new_profile, new_colors) = old, new
    if new_colors != colors:
        rx.put(SET_COLORS, colors_write(new_colors))
    if new_profile != profile:
        rx.put(SET_PROFILE, new_profile)
    got = read_state(rx)
    if got != new:
        raise KreoError("read-back does not match what was written; run `kreo restore`")


def save(rx, path, profile, colors):
    os.makedirs(path, exist_ok=True)
    for name, data in (("profile.bin", profile), ("light_color.bin", colors),
                       ("custom_light.bin", rx.get(GET_CUSTOM))):
        with open(os.path.join(path, name), "wb") as f:
            f.write(data)


def parse_effect(value):
    names = {v: k for k, v in EFFECTS.items()}
    effect = names.get(value) if not value.isdigit() else int(value)
    if effect not in EFFECTS:
        raise KreoError(f"unknown or colorless effect {value!r}; see `kreo effects`")
    return effect


def parse_level(value, flag):
    if not value.isdigit() or int(value) > BRIGHTNESS_MAX:
        raise KreoError(f"{flag} takes 0-{BRIGHTNESS_MAX}")
    return int(value)


def parse_color(value):
    h = value.lstrip("#")
    if len(h) != 6 or any(ch not in "0123456789abcdefABCDEF" for ch in h):
        raise KreoError(f"not a #rrggbb color: {value!r}")
    return bytes.fromhex(h)


def cmd_set(rx, args):
    color = args[0]
    if color.startswith("@"):
        with open(color[1:]) as f:
            color = f.read().strip()
    rgb, opts, dry = parse_color(color), {}, False
    rest = iter(args[1:])
    for arg in rest:
        if arg == "--dry-run":
            dry = True
        elif arg in ("--effect", "--brightness", "--speed"):
            opts[arg] = next(rest, "")
        else:
            raise KreoError(f"unknown option {arg!r}")
    old = read_state(rx)
    effect = parse_effect(opts["--effect"]) if "--effect" in opts else effect_of(old[0])
    if effect not in EFFECTS:
        print(f"kreo: {describe(*old)} takes no color; left as is (pick one with --effect)")
        return
    new = build(*old, rgb, effect,
                parse_level(opts["--brightness"], "--brightness") if "--brightness" in opts else None,
                parse_level(opts["--speed"], "--speed") if "--speed" in opts else None)
    if new == old:
        print(f"kreo: already {describe(*old)}")
        return
    print(f"kreo: {describe(*old)} -> {describe(*new)}")
    if dry:
        print("kreo: dry run, nothing written")
        return
    if not os.path.isdir(ORIGINAL):
        save(rx, ORIGINAL, *old)
        print(f"kreo: saved the original lighting to {ORIGINAL}")
    write(rx, old, new)


def cmd_restore(rx, path):
    with open(os.path.join(path, "profile.bin"), "rb") as f:
        saved_profile = f.read()
    with open(os.path.join(path, "light_color.bin"), "rb") as f:
        saved_colors = f.read()
    check(saved_profile, saved_colors)
    old = read_state(rx)
    # only the bytes `set` can change come from the backup; debounce, sleep
    # timer, NKRO and everything else stay as they are now
    p, c = bytearray(old[0]), bytearray(old[1])
    for i in SET_PROFILE_BYTES:
        p[i] = saved_profile[i]
    for i in SET_COLOR_BYTES:
        c[i] = saved_colors[i]
    new = (bytes(p), bytes(c))
    if new == old:
        print(f"kreo: already as in {path}")
        return
    write(rx, old, new)
    print(f"kreo: restored {describe(*new)}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"
    if cmd == "effects":
        for effect, name in EFFECTS.items():
            print(f"{effect}\t{name}")
        return
    if cmd not in ("status", "set", "backup", "restore") or (cmd == "set" and len(args) < 2):
        sys.exit(__doc__)
    os.makedirs(DATA, exist_ok=True)
    with open(os.path.join(DATA, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # one writer at a time (fast theme switching)
        rx = Receiver(os.environ.get("KREO_HIDRAW"))
        try:
            if cmd == "status":
                profile, colors = read_state(rx)
                level, charging = rx.get(GET_POWER)[:2]
                print(describe(profile, colors))
                print(f"battery {level}%{' (charging)' if charging >> 4 else ''}")
            elif cmd == "set":
                cmd_set(rx, args[1:])
            elif cmd == "backup":
                path = args[1] if len(args) > 1 else os.path.join(DATA, time.strftime("backup-%Y%m%d-%H%M%S"))
                save(rx, path, *read_state(rx))
                print(f"kreo: saved to {path}")
            elif cmd == "restore":
                cmd_restore(rx, args[1] if len(args) > 1 else ORIGINAL)
        finally:
            rx.close()


if __name__ == "__main__":
    try:
        main()
    except (KreoError, OSError) as e:
        sys.exit(f"kreo: {e}")
