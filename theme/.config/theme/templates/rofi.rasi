  pink: {{pink}};
  mauve: {{accent}};
  red: {{red}};
  maroon: {{maroon}};
  peach: {{peach}};
  yellow: {{yellow}};
  green: {{green}};
  teal: {{teal}};
  sky: {{sky}};
  sapphire: {{sapphire}};
  blue: {{blue}};
  lavender: {{lavender}};
  text: {{text}};
  subtext1: {{subtext1}};
  subtext0: {{subtext0}};
  overlay2: {{overlay2}};
  overlay1: {{overlay1}};
  overlay0: {{overlay0}};
  surface2: {{surface2}};
  surface1: {{surface1}};
  surface0: {{surface0}};
  base: {{base}};
  mantle: {{mantle}};
  crust: {{crust}};
  accent: {{accent}};
  on-accent: {{on_accent}};
  accent-container: {{accent_container}};
  secondary: {{secondary}};
  base-alpha: {{base | alpha: 0.95}};
  base-alpha-strong: {{base | alpha: 0.98}};
}
