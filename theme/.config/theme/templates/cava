; generated by ~/.config/theme/theme ({{name}}) -- edit the template in ~/.config/theme/templates
[general]
framerate = 60
bars = 70
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = mono
mono_option = average
reverse = 0   ; set to 1 if you want treble on left and bass on right

[color]
background = '{{base}}'

gradient = 1

gradient_color_1 = '{{teal}}'
gradient_color_2 = '{{sky}}'
gradient_color_3 = '{{sapphire}}'
gradient_color_4 = '{{blue}}'
gradient_color_5 = '{{accent}}'
gradient_color_6 = '{{pink}}'
gradient_color_7 = '{{maroon}}'
gradient_color_8 = '{{red}}'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
