# generated by ~/.config/theme/theme ({{name}}) -- edit the template in ~/.config/theme/templates
theme[main_bg]=""
theme[main_fg]="{{text}}"
theme[title]="{{text}}"
theme[hi_fg]="{{accent}}"
theme[selected_bg]="{{surface1}}"
theme[selected_fg]="{{accent}}"
theme[inactive_fg]="{{overlay2}}"
theme[graph_text]="{{subtext1}}"
theme[meter_bg]="{{surface1}}"
theme[proc_misc]="{{lavender}}"
theme[cpu_box]="{{accent}}"
theme[mem_box]="{{green}}"
theme[net_box]="{{red}}"
theme[proc_box]="{{blue}}"
theme[div_line]="{{surface1}}"
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"
theme[cpu_start]="{{teal}}"
theme[cpu_mid]="{{sapphire}}"
theme[cpu_end]="{{accent}}"
theme[free_start]="{{accent}}"
theme[free_mid]="{{lavender}}"
theme[free_end]="{{blue}}"
theme[cached_start]="{{sapphire}}"
theme[cached_mid]="{{blue}}"
theme[cached_end]="{{lavender}}"
theme[available_start]="{{peach}}"
theme[available_mid]="{{maroon}}"
theme[available_end]="{{red}}"
theme[used_start]="{{green}}"
theme[used_mid]="{{teal}}"
theme[used_end]="{{sky}}"
theme[download_start]="{{peach}}"
theme[download_mid]="{{red}}"
theme[download_end]="{{accent}}"
theme[upload_start]="{{green}}"
