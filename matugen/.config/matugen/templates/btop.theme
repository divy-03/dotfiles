# generated by matugen from the current wallpaper -- edit the template in ~/.config/matugen/templates
theme[main_bg]=""
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.outline_variant.default.hex}}"
theme[selected_fg]="{{colors.primary.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.outline_variant.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"
theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.green.default.hex}}"
theme[net_box]="{{colors.red.default.hex}}"
theme[proc_box]="{{colors.blue.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"
theme[temp_start]="{{colors.green.default.hex}}"
theme[temp_mid]="{{colors.yellow.default.hex}}"
theme[temp_end]="{{colors.red.default.hex}}"
theme[cpu_start]="{{colors.teal.default.hex}}"
theme[cpu_mid]="{{colors.sapphire.default.hex}}"
theme[cpu_end]="{{colors.primary.default.hex}}"
theme[free_start]="{{colors.primary.default.hex}}"
theme[free_mid]="{{colors.tertiary.default.hex}}"
theme[free_end]="{{colors.blue.default.hex}}"
theme[cached_start]="{{colors.sapphire.default.hex}}"
theme[cached_mid]="{{colors.blue.default.hex}}"
theme[cached_end]="{{colors.tertiary.default.hex}}"
theme[available_start]="{{colors.peach.default.hex}}"
theme[available_mid]="{{colors.maroon.default.hex}}"
theme[available_end]="{{colors.red.default.hex}}"
theme[used_start]="{{colors.green.default.hex}}"
theme[used_mid]="{{colors.teal.default.hex}}"
theme[used_end]="{{colors.sky.default.hex}}"
theme[download_start]="{{colors.peach.default.hex}}"
theme[download_mid]="{{colors.red.default.hex}}"
theme[download_end]="{{colors.primary.default.hex}}"
theme[upload_start]="{{colors.green.default.hex}}"
theme[upload_mid]="{{colors.teal.default.hex}}"
theme[upload_end]="{{colors.blue.default.hex}}"
theme[process_start]="{{colors.sapphire.default.hex}}"
theme[process_mid]="{{colors.tertiary.default.hex}}"
theme[process_end]="{{colors.primary.default.hex}}"
