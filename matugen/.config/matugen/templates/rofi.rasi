/* generated by matugen from the current wallpaper -- edit the template in ~/.config/matugen/templates */
* {
  rosewater: {{colors.rosewater.default.hex}};
  flamingo: {{colors.flamingo.default.hex}};
  pink: {{colors.pink.default.hex}};
  mauve: {{colors.primary.default.hex}};
  red: {{colors.red.default.hex}};
  maroon: {{colors.maroon.default.hex}};
  peach: {{colors.peach.default.hex}};
  yellow: {{colors.yellow.default.hex}};
  green: {{colors.green.default.hex}};
  teal: {{colors.teal.default.hex}};
  sky: {{colors.sky.default.hex}};
  sapphire: {{colors.sapphire.default.hex}};
  blue: {{colors.blue.default.hex}};
  lavender: {{colors.tertiary.default.hex}};
  text: {{colors.on_surface.default.hex}};
  subtext1: {{colors.on_surface_variant.default.hex}};
  subtext0: {{colors.on_surface_variant.default.hex | lighten: -8}};
  overlay2: {{colors.outline.default.hex}};
  overlay1: {{colors.outline.default.hex | lighten: -5}};
  overlay0: {{colors.outline.default.hex | lighten: -10}};
  surface2: {{colors.outline_variant.default.hex | lighten: 8}};
  surface1: {{colors.outline_variant.default.hex}};
  surface0: {{colors.surface_container_highest.default.hex}};
  base: {{colors.surface_container_low.default.hex}};
  mantle: {{colors.surface.default.hex}};
  crust: {{colors.surface_container_lowest.default.hex}};
  accent: {{colors.primary.default.hex}};
  on-accent: {{colors.on_primary.default.hex}};
  accent-container: {{colors.primary_container.default.hex}};
  secondary: {{colors.secondary.default.hex}};
  base-alpha: {{colors.surface_container_low.default.rgba | set_alpha: 0.95}};
  base-alpha-strong: {{colors.surface_container_low.default.rgba | set_alpha: 0.98}};
}
