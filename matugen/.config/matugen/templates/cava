; generated by matugen from the current wallpaper -- edit the template in ~/.config/matugen/templates
[general]
framerate = 60
bars = 70
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = mono
mono_option = average
reverse = 0   ; set to 1 if you want treble on left and bass on right

[color]
background = '{{colors.surface_container_low.default.hex}}'

gradient = 1

gradient_color_1 = '{{colors.teal.default.hex}}'
gradient_color_2 = '{{colors.sky.default.hex}}'
gradient_color_3 = '{{colors.sapphire.default.hex}}'
gradient_color_4 = '{{colors.blue.default.hex}}'
gradient_color_5 = '{{colors.primary.default.hex}}'
gradient_color_6 = '{{colors.pink.default.hex}}'
gradient_color_7 = '{{colors.maroon.default.hex}}'
gradient_color_8 = '{{colors.red.default.hex}}'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
