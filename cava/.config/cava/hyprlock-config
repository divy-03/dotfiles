# cava profile for the hyprlock lock screen (see Scripts/cava-hyprlock.sh).
#
# Kept separate from waybar-config on purpose: cava-waybar.sh identifies its own
# instance with `pkill -f "cava -p <config>"`, so sharing one config file would let
# a waybar restart kill the lock screen's cava too.
#
# Sized for the visualizer across the bottom of the lock screen: bars x the
# label's cell width (20px at font_size 25) is the 1920px screen width, and
# ascii_max_range is 8 levels per row -- 96 draws 12 rows of 44px, half the
# screen. At that size the cells are whole pixels, so the rows tile without seams.

[general]
framerate = 20
bars = 96
autosens = 1

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 96
channels = mono
mono_option = average

[smoothing]
noise_reduction = 45
monstercat = 1
waves = 0
