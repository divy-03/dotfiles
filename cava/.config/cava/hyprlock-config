# cava profile for the hyprlock lock screen (see Scripts/cava-hyprlock.sh).
#
# Kept separate from waybar-config on purpose: cava-waybar.sh identifies its own
# instance with `pkill -f "cava -p <config>"`, so sharing one config file would let
# a waybar restart kill the lock screen's cava too.
#
# Wider than the bar version -- this one gets a whole screen instead of a pill.

[general]
framerate = 20
bars = 70
autosens = 1

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
channels = mono
mono_option = average

[smoothing]
noise_reduction = 45
monstercat = 1
waves = 0
