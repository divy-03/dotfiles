@import "shared/mocha.rasi"
@import "shared/fonts.rasi"

* {
    background:                  @base;
    background-alt:              @surface0;
    foreground:                  @text;
    selected:                    @mauve;
    border-col:                  @surface2;
    accent:                      @peach;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  true;

    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @border-col;
    background-color:            rgba(30, 30, 46, 0.98);
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     20px;
    margin:                      0px;
    padding:                     120px 200px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    children:                    [ "message", "listview" ];
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     20px 25px;
    border:                      2px solid;
    border-radius:               15px;
    border-color:                @border-col;
    background-color:            @surface0;
}

textbox {
    background-color:            transparent;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    highlight:                   none;
    font:                        "JetBrainsMono Nerd Font Bold 14";
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       4;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;

    spacing:                     8px;
    margin:                      0px;
    padding:                     10px 5px 10px 10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}

scrollbar {
    width:                       6px;
    handle-width:                6px;
    handle-color:                @selected;
    border-radius:               8px;
    background-color:            @surface0;
    margin:                      0px 0px 0px 5px;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     12px 16px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                @selected;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @surface1;
    text-color:                  @accent;
    border:                      1px solid;
    border-color:                @selected;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        28px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   @accent;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    font:                        "JetBrainsMono Nerd Font 12";
}

/*****----- Error Message -----*****/
error-message {
    padding:                     20px;
    border:                      2px solid;
    border-radius:               16px;
    border-color:                @red;
    background-color:            @background;
    text-color:                  @foreground;
}
