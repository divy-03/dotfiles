{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "cssPriority": "user",
  "layer": "overlay",
  "layer-shell": true,
  "control-center-layer": "top",
  "control-center-width": 380,
  "control-center-height": 950,
  "control-center-margin-top": 10,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 10,
  "control-center-margin-left": 0,
  "notification-window-width": 350,
  "notification-window-height": 280,
  "notification-icon-size": 70,
  "notification-body-image-height": 200,
  "notification-body-image-width": 200,
  "notification-2fa-action": true,
  "notifications-inline-replies": true,
  "notification-stack-limit": 5,
  "stack-duplicates": true,
  "stack-btn": true,
  "timeout": 3,
  "timeout-low": 2,
  "timeout-critical": 10,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "mpris",
    "dnd",
    "buttons-grid#reminder",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "NOTIFICATIONS",
      "clear-all-button": true,
      "button-text": "󰩺  CLEAR"
    },
    "dnd": {
      "text": "FUCK OFF "
    },
    "mpris": {
      "image-size": 76,
      "image-radius": 10
    },
    "buttons-grid#reminder": {
      "buttons-per-row": 1,
      "actions": [
        {
          "label": "⏰ TASK REMINDERS",
          "type": "toggle",
          "active": true,
          "command": "/home/divy/.config/hypr/Scripts/daily-task-reminder-toggle.sh apply",
          "update-command": "/home/divy/.config/hypr/Scripts/daily-task-reminder-toggle.sh status"
        }
      ]
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰐥",
          "command": "systemctl poweroff"
        },
        {
          "label": "󰜉",
          "command": "systemctl reboot"
        },
        {
          "label": "󰤄",
          "command": "systemctl suspend"
        },
        {
          "label": "󰍃",
          "command": "loginctl terminate-user $USER"
        },
        {
          "label": "󰌾",
          "command": "hyprlock"
        }
      ]
    }
  }
}
